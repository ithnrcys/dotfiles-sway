[Desktop Entry]
Type=Application
Name=Files
Comment=File manager (Spacedrive 0.4.3, unpacked into ~/.local/opt/spacedrive, restyled by spacedrive/patch.py)
Exec=/home/ocx/.local/bin/spacedrive %U
Icon=spacedrive
Terminal=false
Categories=System;FileTools;FileManager;
MimeType=inode/directory;x-scheme-handler/spacedrive;
StartupWMClass=Spacedrive
