configuration {
    font: "JetBrainsMono Nerd Font 9.75";
    show-icons: true;
    display-drun: "λ";
}

@import "colors.rasi"

/* The "Nuke" button for all default margins/borders */
* {
    border: 0px;
    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

window {
    location: north west;
    anchor: north west;
    width: 700px;
    x-offset: -2px;
    y-offset: -28px;

    background-color: @background;
    
    /* We force these to 0 to stop the "ghost border" */
    border: 0px;
    padding: 0px;
}

mainbox {
    background-color: transparent;
    border: 0px;
    padding: 0px;
    children: [ inputbar, listview ];
}

inputbar {
    /* Putting the color and height control back here */
    background-color: @background;
    /* Adjust these two numbers (4px and 2px) to match your Polybar height exactly */
    padding: 4px 10px 2px 10px; 
    children: [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color: @selected;
    font: "JetBrainsMono Nerd Font Bold 9.75";
    margin: 0px 8px 0px 0px;
}

entry {
    background-color: transparent;
    text-color: @foreground;
    placeholder: "search...";
    placeholder-color: #565f89;
    vertical-align: 0.5;
}

listview {
    background-color: transparent;
    border: 0px;
    lines: 5;
    spacing: 2px;
    scrollbar: false;
    require-input: true;
    fixed-height: false;
    dynamic: true;
    /* This only adds space when the menu expands */
    padding: 5px 10px 10px 10px; 
}

element {
    padding: 2px 10px;
    border-radius: 0px;
    /* We set this to transparent here, but we must also override the 'alternate' states below */
    background-color: transparent;
    text-color: @foreground;
}

/* This is the fix: Force both 'normal' and 'alternate' rows to look exactly the same */
element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @foreground;
}

/* Keep your selection highlight exactly as it is */
element selected.normal {
    background-color: @selected;
    text-color: @background;
}

/* These handle the text and icons inside those rows */
element-text, element-icon {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

element selected {
    background-color: @selected;
    text-color: @background;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

element-icon {
    size: 0.85em;
    margin: 0px 8px 0px 0px;
}
