/* Now-playing dropup for the bottom bar: the cover art and nothing else.
   music-module.sh passes the cover path as  icon-cover { filename: "..."; }  */
@import "dropup-left.rasi"

window {
    width: 300px;
    x-offset: 44px;      /* clear of the power button, above the music module */
    padding: 0px;
}

mainbox {
    children: [ icon-cover, listview ];
    padding: 0px;
    spacing: 0px;
}

icon-cover {
    expand: false;
    size: 300px;
    padding: 0px;
}

/* rofi only draws the cover when a listview is present, so one empty row stays in the
   layout, squeezed to nothing and painted in the background colour */
listview {
    lines: 1;
    padding: 0px;
    margin: 0px;
    spacing: 0px;
    border: 0px;
}
element {
    padding: 0px;
    margin: 0px;
    border: 0px;
    children: [ element-text ];
}
element-text {
    font: "JetBrainsMono Nerd Font 1";
    padding: 0px;
}
element normal.normal, element selected.normal, element alternate.normal, element-text {
    background-color: @background;
    text-color: @background;
}
