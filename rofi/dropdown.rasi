@import "config.rasi"

window {
    /* flush under the top bar, against the right edge */
    location: north east;
    anchor: north east;
    width: 410px;
    y-offset: 0px;
    x-offset: 0px;
}

/* Redefine the mainbox to ONLY contain the list (nukes the inputbar safely) */
mainbox {
    children: [ listview ];
}

/* Override your master config's "hide until typing" rules */
listview {
    require-input: false;
    
    /* Tell Rofi to shrink to fit the content */
    fixed-height: false;
    dynamic: true;
    
    /* This is now the MAXIMUM lines before a scrollbar appears */
    lines: 8; 
}
