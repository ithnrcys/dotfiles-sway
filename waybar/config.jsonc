// ~/.config/waybar/config.jsonc — two bars, greyscale, kaze port
[

// ────────────────────────── TOP BAR ──────────────────────────
{
  "name": "top",
  "layer": "top",
  "position": "top",
  "height": 28,

  "modules-left":   ["sway/window", "cpu", "memory", "temperature", "custom/updates", "custom/cpusnap"],
  "modules-center": ["custom/workspaces"],
  "modules-right":  ["clock", "custom/weather", "custom/bt", "custom/power"],

  // focused window — λ + app name, reverse-DNS ids shortened
  "sway/window": {
  "max-length": 40,
  // click: app launcher, same as ctrl+space
  "on-click": "pkill -x rofi || rofi -show drun",
  "tooltip": false,
  "format": "λ {app_id}  <span size='13pt'>✧</span>  ",
  "rewrite": {
    // nothing focused (empty workspace): app_id is empty, show the username instead
    "λ   (<span.*)": "λ ocx  $1",
    "λ com\\.mitchellh\\.ghostty(.*)": "λ ghostty$1",
    "λ org\\.mozilla\\.firefox(.*)": "λ firefox$1",
    "λ steamwebhelper(.*)": "λ steam$1",
    "λ (.*)": "λ $1"
  }
  },

  // workspaces — custom script: [n] brackets the focused one
  "custom/workspaces": {
    "exec": "~/.config/waybar/scripts/workspaces.sh",
    "format": "{}",
    "tooltip": false
  },

  // invisible: prints nothing, just keeps a 1-2 s old /proc/stat copy so the cpu panel opens instantly
  "custom/cpusnap": { "exec": "~/.config/waybar/scripts/cpu-module.sh --snapshot", "interval": 1, "tooltip": false },

  // click: rofi panel with total usage, temp, freq, load and per-core bars
  "cpu":    { "interval": 1, "format": "<span size='9pt'></span> \u2009{usage}%  <span size='13pt'>✧</span>  ", "tooltip": false,
              "on-click": "~/.config/waybar/scripts/cpu-module.sh" },
  // click: rofi menu with ram, cache and swap
  "memory": { "interval": 2, "format": "<span size='11pt'>󰍛</span> \u2009{used:0.1f}G  <span size='13pt'>✧</span>  ", "tooltip": false,
              "on-click": "~/.config/waybar/scripts/mem-module.sh" },

  // CPU die temp — k10temp; hwmon number can shift after reboot,
  // re-check with: for i in /sys/class/hwmon/hwmon*; do echo "$i $(cat $i/name)"; done
  "temperature": {
    "hwmon-path": "/sys/class/hwmon/hwmon4/temp1_input",
    "interval": 2,
    "tooltip": false,
    "format": "<span size='11pt'>󱩱</span> \u2009{temperatureC}°C  <span size='13pt'>✧</span>  ",
    "critical-threshold": 85
  },

  // pending zypper updates (no-refresh count, every 30 min)
  "custom/updates": {
    "exec": "~/.config/waybar/scripts/updates.sh",
    "interval": 1800,
    "tooltip": false,
    "signal": 8,
    // click: terminal listing the updates, with a prompt to run zypper dup
    "on-click": "ghostty -e ~/.config/waybar/scripts/updates.sh --show",
    "format": "<span size='11pt'>󰳢</span> \u2009{}"
  },

  // 12h clock — click opens the calendar app (renCal)
  "clock": {
    "format": "{:%a %d %b  %I:%M %p}  <span size='13pt'>✧</span>  ",
    "tooltip": false,
    "on-click": "rencal"
  },

  // wttr.in — icon follows the current condition (day/night variants)
  "custom/weather": {
    "exec": "~/.config/waybar/scripts/weather-module.sh",
    "interval": 900,
    "tooltip": false,
    // click: Mousam (flatpak weather app)
    "on-click": "flatpak run io.github.amit9838.mousam",
    "format": "{}  <span size='13pt'>✧</span>  "
  },

  // bluetooth — click for rofi device menu
  "custom/bt": {
    "exec": "~/.config/waybar/scripts/bt-module.sh --status",
    "interval": 5,
    "tooltip": false,
    "format": "{}  <span size='13pt'>✧</span>  ",
    "on-click": "~/.config/waybar/scripts/bt-module.sh --menu"
  },

  // power menu (rofi) — edge gap comes from CSS padding-right, not spaces
  "custom/power": {
    "format": "<span size='11pt'>󰤁</span>",
    "on-click": "~/.config/waybar/scripts/power-module.sh"
  }
},

// ──────────────────────── BOTTOM BAR ─────────────────────────
{
  "name": "bottom",
  "layer": "top",
  "position": "bottom",
  "height": 28,

  "modules-left":   ["custom/nowplaying"],
  "modules-center": ["custom/procs", "custom/uptime", "network"],
  "modules-right":  ["custom/volume", "custom/brightness", "tray"],

  // playerctl → mpd fallback; empty when nothing plays.
  // Continuous script (no interval): long titles scroll in bursts, see nowplaying.sh
  "custom/nowplaying": {
    "exec": "~/.config/waybar/scripts/nowplaying.sh",
    "escape": true,
    "tooltip": false
  },

  // running process count — click opens btop
  "custom/procs": {
    "exec": "ps -e --no-headers | wc -l",
    "interval": 5,
    "format": "󰀻 \u2009{}  <span size='13pt'>✧</span>  ",
    "tooltip": false,
    "on-click": "ghostty -e btop"
  },

  "custom/uptime": {
    "exec": "uptime -p | sed 's/up //'",
    "interval": 60,
    "format": "󰅐 \u2009{}  <span size='13pt'>✧</span>  "
  },

  "network": {
    "format-wifi": "󰀂 \u2009{signalStrength}%  <span size='13pt'>✧</span>  󰓅  {bandwidthDownBits}",
    "format-ethernet": "󰈀 \u2009{ipaddr}",
    "format-disconnected": "󰀂 \u2009offline",
    // wifi radio switched off (rfkill): without this the module is empty and disappears,
    // taking the click menu (and its "Turn ON" entry) with it
    "format-disabled": "󰀂 \u2009offline",
    "interval": 3,
    "tooltip": false,
    // click: rofi network list opening upward from the bottom bar
    "on-click": "ROFI_THEME=dropup.rasi ~/.config/waybar/scripts/wifi-module.sh --menu"
  },

  // tray sits at the right edge; separator before it comes from the brightness format
  "tray": { "spacing": 8 },

  // thin-line lever slider ⎯⎯⎯◈ ; scroll/click wired to pamixer
  "custom/volume": {
    "exec": "~/.config/waybar/scripts/volume-bar.sh",
    "interval": 1,
    "format": "{}    ",
    "on-scroll-up": "pamixer -i 2",
    "on-scroll-down": "pamixer -d 2",
    "on-click": "pamixer --toggle-mute"
  },

  // monitor brightness over DDC/CI (ddcutil, i2c)
  "custom/brightness": {
    "exec": "~/.config/waybar/scripts/brightness-module.sh",
    "interval": 5,
    "format": "{}  <span size='13pt'>✧</span>  ",
    "on-scroll-up": "ddcutil setvcp 10 + 10",
    "on-scroll-down": "ddcutil setvcp 10 - 10"
  }
}
]
