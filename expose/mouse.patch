diff --git a/windows.c b/windows.c
index 0e6c19d..9a670b8 100644
--- a/windows.c
+++ b/windows.c
@@ -166,6 +166,59 @@ static void enter (void *data) {
     }
 }
 
+// mouse: the window under the pointer is selected; pointer position is in
+// surface coordinates, the layout in buffer pixels
+static double pointer_x = -1, pointer_y = -1;
+
+static int32_t window_at_pointer (struct windows *w) {
+  float  scale = w->xs->scale > 0 ? w->xs->scale : 1;
+  double x = pointer_x * scale, y = pointer_y * scale;
+
+  for (uint32_t i = 0; i < w->ea->window_count; i++) {
+    struct expose_algorithm_window *eaw = &w->ea->eaw[i];
+
+    if (x >= eaw->x && x < eaw->x + eaw->width * eaw->scale && y >= eaw->y &&
+        y < eaw->y + eaw->height * eaw->scale)
+      return i;
+  }
+
+  return -1;
+}
+
+static void motion (void *data, double x, double y) {
+  struct windows *w = data;
+
+  pointer_x = x;
+  pointer_y = y;
+
+  int32_t hit = window_at_pointer (w);
+
+  if (hit < 0 || w->ea->eaw[hit].focused)
+    return;
+
+  for (uint32_t i = 0; i < w->ea->window_count; i++)
+    w->ea->eaw[i].focused = false;
+
+  w->ea->eaw[hit].focused = true;
+  w->render               = true;
+}
+
+// a click on a window picks it, a click on the background closes the overview
+static void click (void *data) {
+  struct windows *w = data;
+
+  int32_t hit = window_at_pointer (w);
+
+  if (hit >= 0) {
+    for (uint32_t i = 0; i < w->ea->window_count; i++)
+      w->ea->eaw[i].focused = false;
+
+    w->ea->eaw[hit].focused = true;
+    enter (w);
+  } else
+    w->xs->close = true;
+}
+
 int32_t main (int32_t argc, char **argv) {
   // remove this when debugging
   sigaction (SIGSEGV, &(struct sigaction){.sa_handler = crash}, NULL);
