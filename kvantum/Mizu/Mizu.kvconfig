[%General]
author=ocx
comment=Square, monochrome Qt theme in the waybar palette (drawn by ../build-svg.py)
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
left_tabs=true
attach_active_tab=false
mirror_doc_tabs=false
group_toolbar_buttons=false
toolbar_item_spacing=2
toolbar_interior_spacing=2
spread_progressbar=true
spread_menuitems=true
spread_header=true
composite=false
translucent_windows=false
blurring=false
popup_blurring=false
menu_shadow_depth=0
tooltip_shadow_depth=0
splitter_width=5
scroll_width=8
scroll_min_extent=40
scroll_arrows=false
scrollbar_in_view=false
transient_scrollbar=false
slider_width=4
slider_handle_width=14
slider_handle_length=14
tickless_slider_handle_size=14
check_size=16
progressbar_thickness=6
textless_progressbar=false
menubar_mouse_tracking=true
toolbutton_style=0
click_behavior=0
vertical_spin_indicators=false
inline_spin_indicators=true
spin_button_width=20
combo_as_lineedit=false
square_combo_button=false
combo_menu=true
hide_combo_checkboxes=true
combo_focus_rect=false
fill_rubberband=false
merge_menubar_with_toolbar=true
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=22
layout_spacing=4
layout_margin=6
submenu_overlap=0
tooltip_delay=-1
animate_states=false
tree_branch_line=false
no_window_pattern=true
respect_DE=false
dialog_button_layout=0
groupbox_top_label=true
button_contents_shift=false
contrast=1.00
intensity=1.00
saturation=1.00
shadowless_popup=true

[GeneralColors]
window.color=#070708
base.color=#0B0B0D
alt.base.color=#0F0F12
button.color=#131315
light.color=#2E2E37
mid.light.color=#2A2A32
dark.color=#070708
mid.color=#1B1B20
highlight.color=#BABAC6
inactive.highlight.color=#7C7C84
text.color=#E3E2E9
window.text.color=#E3E2E9
button.text.color=#E3E2E9
disabled.text.color=#7C7C84
tooltip.text.color=#E3E2E9
tooltip.base.color=#070708
highlight.text.color=#070708
link.color=#BABAC6
link.visited.color=#7C7C84
progress.indicator.text.color=#E3E2E9

[Hacks]
respect_darkness=true
transparent_ktitle_label=true
transparent_dolphin_view=false
transparent_pcmanfm_sidepane=false
blur_translucent=false
normal_default_pushbutton=true
iconless_pushbutton=false
iconless_menu=false
single_top_toolbar=true
middle_click_scroll=false
lxqtmainmenu_iconsize=0
tint_on_mouseover=0
no_selection_tint=true
disabled_icon_opacity=50

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
interior=true
interior.element=button
indicator.size=8
indicator.element=arrow
text.normal.color=#E3E2E9
text.focus.color=#E3E2E9
text.press.color=#E3E2E9
text.toggle.color=#070708
text.shadow=0
text.margin=1
text.iconspacing=5
text.margin.top=4
text.margin.bottom=4
text.margin.left=8
text.margin.right=8
min_height=1.9font

[PanelButtonTool]
inherits=PanelButtonCommand
interior.element=tbutton
frame.element=tbutton
text.toggle.color=#E3E2E9
text.margin.left=4
text.margin.right=4
min_height=0

[ToolbarButton]
inherits=PanelButtonTool

[Dock]
inherits=PanelButtonCommand
interior.element=dock
frame.element=dock
text.margin.top=2
text.margin.bottom=2
text.margin.left=2
text.margin.right=2
min_height=0

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=false
text.bold=false
min_height=0

[IndicatorSpinBox]
inherits=LineEdit
indicator.element=spin
indicator.size=8
text.margin.left=4
text.margin.right=4

[RadioButton]
inherits=PanelButtonCommand
frame=false
interior.element=radio
text.margin.top=2
text.margin.bottom=2
text.margin.left=4
text.margin.right=4
min_height=0

[CheckBox]
inherits=PanelButtonCommand
frame=false
interior.element=checkbox
text.margin.top=2
text.margin.bottom=2
text.margin.left=4
text.margin.right=4
min_height=0

[Focus]
inherits=PanelButtonCommand
frame=true
frame.element=focus
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
frame.patternsize=14

[GenericFrame]
inherits=PanelButtonCommand
frame=true
interior=false
frame.element=common
interior.element=common
min_height=0

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
text.margin.left=6
text.margin.right=6

[ComboBox]
inherits=PanelButtonCommand
indicator.element=arrow
text.margin.left=8
text.margin.right=6

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=arrow-down

[IndicatorArrow]
indicator.element=arrow
indicator.size=8

[ToolboxTab]
inherits=PanelButtonCommand
text.toggle.color=#070708

[Tab]
inherits=PanelButtonCommand
interior.element=tab
frame.element=tab
indicator.element=tab
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.normal.color=#7C7C84
text.focus.color=#E3E2E9
text.press.color=#E3E2E9
text.toggle.color=#E3E2E9
text.margin.top=4
text.margin.bottom=4
text.margin.left=12
text.margin.right=12
min_width=+2

[TabFrame]
inherits=PanelButtonCommand
frame.element=tabframe
interior=false
min_height=0

[TabBarFrame]
inherits=GenericFrame
frame=false
interior=false

[TreeExpander]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=tree
indicator.size=8
min_height=0

[HeaderSection]
inherits=PanelButtonCommand
frame.element=header
interior.element=header
text.toggle.color=#E3E2E9
text.margin.top=3
text.margin.bottom=3
text.margin.left=6
text.margin.right=6
min_height=0

[SizeGrip]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=resize-grip
indicator.size=10
min_height=0

[Toolbar]
inherits=PanelButtonCommand
indicator.element=toolbar
indicator.size=5
frame=false
interior=true
interior.element=toolbar
text.margin=0
text.margin.top=2
text.margin.bottom=2
text.margin.left=2
text.margin.right=2
min_height=0

[MenuBar]
inherits=PanelButtonCommand
frame=true
frame.element=menubar
interior=true
interior.element=menubar
frame.top=0
frame.left=0
frame.right=0
frame.bottom=1
text.margin.top=0
text.margin.bottom=0
min_height=0

[MenuBarItem]
inherits=PanelButtonCommand
frame.element=menubaritem
interior.element=menubaritem
text.press.color=#070708
text.toggle.color=#070708
text.margin.top=3
text.margin.bottom=3
text.margin.left=6
text.margin.right=6
min_height=0

[Menu]
inherits=PanelButtonCommand
frame.element=menu
interior.element=menu
text.margin.top=0
text.margin.bottom=0
text.margin.left=0
text.margin.right=0
min_height=0

[MenuItem]
inherits=PanelButtonCommand
frame.element=menuitem
interior.element=menuitem
indicator.element=menuitem
text.focus.color=#070708
text.press.color=#070708
text.toggle.color=#070708
text.margin.top=3
text.margin.bottom=3
text.margin.left=8
text.margin.right=8
min_height=0

[ItemView]
inherits=PanelButtonCommand
frame.element=itemview
interior.element=itemview
text.focus.color=#E3E2E9
text.press.color=#070708
text.toggle.color=#070708
text.margin.top=2
text.margin.bottom=2
text.margin.left=4
text.margin.right=4
min_height=0

[Slider]
inherits=PanelButtonCommand
frame.element=slider
interior.element=slider
min_height=0

[SliderCursor]
inherits=PanelButtonCommand
frame=false
interior.element=slidercursor
min_height=0

[Progressbar]
inherits=PanelButtonCommand
frame.element=progress
interior.element=progress
text.focus.color=#E3E2E9
text.press.color=#E3E2E9
text.toggle.color=#E3E2E9
text.margin.top=0
text.margin.bottom=0
text.bold=false
min_height=0

[ProgressbarContents]
inherits=PanelButtonCommand
frame=true
frame.element=progress-pattern
interior.element=progress-pattern
min_height=0

[Splitter]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=splitter-grip
indicator.size=8
min_height=0

[Scrollbar]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=arrow
indicator.size=8
min_height=0

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scrollbarslider
interior.element=scrollbarslider
indicator.size=0
min_height=0

[ScrollbarGroove]
inherits=PanelButtonCommand
frame=false
interior=false
min_height=0

[TitleBar]
inherits=PanelButtonCommand
frame=false
interior.element=titlebar
indicator.size=10
indicator.element=mdi
text.normal.color=#7C7C84
text.focus.color=#E3E2E9
text.bold=false
min_height=0

[GroupBox]
inherits=GenericFrame
frame=true
frame.element=group
text.shadow=0
text.margin=0

[ToolTip]
inherits=GenericFrame
frame=true
frame.element=tooltip
interior=true
interior.element=tooltip
text.margin.top=4
text.margin.bottom=4
text.margin.left=6
text.margin.right=6

[StatusBar]
inherits=GenericFrame
frame=false
interior=false

[Window]
interior=false
