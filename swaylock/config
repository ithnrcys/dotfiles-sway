# ~/.config/swaylock/config — ring and behaviour for the lock screen
# (same options as the swaylock command line, without the leading --)
# The background image is supplied by sway/lock.sh: blurred, darkened wallpaper with "λ user".

# behaviour
daemonize
ignore-empty-password
show-failed-attempts
indicator-caps-lock

# fallback colour if the background image is missing
color=070708
scaling=fill

# indicator: always visible, a hairline ring with nothing inside it
indicator-idle-visible
indicator-radius=70
indicator-thickness=3
font=JetBrainsMono Nerd Font
font-size=15

# no divider lines around the ring or between segments
line-color=00000000
separator-color=00000000

# idle
inside-color=00000000
ring-color=e3e2e9b0
text-color=e3e2e9

# typing: key presses light a white segment, backspace a dim one
key-hl-color=ffffff
bs-hl-color=7C7C84

# password cleared
inside-clear-color=00000000
ring-clear-color=e3e2e960
text-clear-color=e3e2e9
line-clear-color=00000000

# checking the password: ring goes solid white
inside-ver-color=00000000
ring-ver-color=ffffff
text-ver-color=ffffff
line-ver-color=00000000

# wrong password: ring stays white and the inside fills with a light haze
inside-wrong-color=e3e2e940
ring-wrong-color=ffffff
text-wrong-color=ffffff
line-wrong-color=00000000

# caps lock on
inside-caps-lock-color=00000000
ring-caps-lock-color=BABAC6
text-caps-lock-color=BABAC6
line-caps-lock-color=00000000
caps-lock-key-hl-color=ffffff
caps-lock-bs-hl-color=7C7C84
