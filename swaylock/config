# ~/.config/swaylock/config — ring and behaviour for the lock screen
# (same options as the swaylock command line, without the leading --)
# The background image is supplied by sway/lock.sh: blurred, darkened wallpaper with "λ user".

# behaviour
daemonize
ignore-empty-password
show-failed-attempts
indicator-caps-lock

# fallback colour if the background image is missing
color=070708
scaling=fill

# indicator: always visible, a solid ring over a smoked-glass disc
indicator-idle-visible
indicator-radius=92
indicator-thickness=9
font=JetBrainsMono Nerd Font
font-size=17

# no divider lines around the ring or between segments
line-color=00000000
separator-color=00000000

# idle
inside-color=070708b8
ring-color=e3e2e955
text-color=e3e2e9

# typing: key presses light a bright segment, backspace a dim one
key-hl-color=ffffff
bs-hl-color=7C7C84

# password cleared
inside-clear-color=070708b8
ring-clear-color=9A9AA4
text-clear-color=BABAC6
line-clear-color=00000000

# checking the password: full bright ring
inside-ver-color=070708d0
ring-ver-color=e3e2e9
text-ver-color=e3e2e9
line-ver-color=00000000

# wrong password: disc inverts to light, dark text
inside-wrong-color=e3e2e9e6
ring-wrong-color=ffffff
text-wrong-color=070708
line-wrong-color=00000000

# caps lock on
inside-caps-lock-color=070708b8
ring-caps-lock-color=BABAC6
text-caps-lock-color=BABAC6
line-caps-lock-color=00000000
caps-lock-key-hl-color=ffffff
caps-lock-bs-hl-color=7C7C84
