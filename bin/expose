#!/bin/sh
# Window overview: live thumbnails of every open window on every workspace
# ("windows", built by expose/install.sh). Bound to $mod+Tab and to a click on the focused
# workspace icon in the top bar; running this while the overview is open closes it.
#   keyboard: arrow keys pick a window, Enter or space jumps to it, Esc closes
#   mouse:    the window under the pointer is picked, a click jumps to it,
#             a click on the background closes
pkill -x windows && exit 0

output=$(swaymsg -t get_outputs | jq -r '.[] | select(.focused) | .name')
# windows prints the picked window's identifier, or nothing when closed without a pick
picked=$("$HOME/.local/bin/windows" -o "$output") || exit 0
[ -n "$picked" ] || exit 0

con=$(swaymsg -t get_tree | jq -r --arg id "$picked" \
    '.. | objects | select(.foreign_toplevel_identifier? == $id) | .id' | head -n 1)
[ -n "$con" ] && swaymsg -q "[con_id=$con] focus"
