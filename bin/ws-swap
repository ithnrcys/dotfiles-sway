#!/usr/bin/env bash
# Swap the icons of two workspaces on the top bar (waybar/scripts/workspace-icons.txt).
#   ws-swap                  list the workspaces with their icons and colours
#   ws-swap 6 7              the icons of workspaces 6 and 7 trade places, colours travel with them
#   ws-swap -k 6 7           trade the icons only, each workspace keeps its own colour
# Only the icons move: the windows stay on their workspaces.

FILE="$HOME/.dotfiles/waybar/scripts/workspace-icons.txt"

usage() { sed -n '2,6s/^# \{0,1\}//p' "$0"; exit "${1:-0}"; }

list() {
    local ws off on color r g b
    while read -r ws off on color; do
        [[ "$ws" == \#* || -z "$ws" ]] && continue
        if [ -n "$color" ]; then
            r=$((16#${color:1:2})) g=$((16#${color:3:2})) b=$((16#${color:5:2}))
            printf '%3s  \e[38;2;%d;%d;%dm%s %s\e[0m  %s\n' "$ws" "$r" "$g" "$b" "$off" "$on" "$color"
        else
            printf '%3s  %s %s  default\n' "$ws" "$off" "$on"
        fi
    done < "$FILE"
}

keep=0
case "$1" in
    "")        list; exit 0 ;;
    -h|--help) usage ;;
    -k|--keep-colors|--keep-colours) keep=1; shift ;;
esac
[ $# -eq 2 ] || usage 1
a="$1" b="$2"

for ws in "$a" "$b"; do
    grep -q "^$ws " "$FILE" || { echo "ws-swap: no workspace '$ws' in $FILE" >&2; exit 1; }
done
[ "$a" = "$b" ] && { echo "ws-swap: pick two different workspaces" >&2; exit 1; }

tmp=$(mktemp)
awk -v a="$a" -v b="$b" -v keep="$keep" '
    # first pass: remember the icons (and colour) of both workspaces
    NR == FNR { if ($1 == a || $1 == b) { off[$1] = $2; on[$1] = $3; color[$1] = $4 } next }
    /^#/ || NF == 0 { print; next }
    $1 == a || $1 == b {
        from = ($1 == a) ? b : a
        c = keep ? color[$1] : color[from]
        print $1, off[from], on[from] (c == "" ? "" : " " c); next }
    { print }' "$FILE" "$FILE" > "$tmp" && cat "$tmp" > "$FILE"   # cat keeps the symlink/inode
rm -f "$tmp"

pkill -SIGUSR2 -x waybar      # reload the bar so the new order shows
list
