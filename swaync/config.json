{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "cssPriority": "user",

  "positionX": "right",
  "positionY": "bottom",
  "layer": "overlay",
  "layer-shell": true,
  "layer-shell-cover-screen": true,

  "control-center-positionX": "right",
  "control-center-positionY": "top",
  "control-center-layer": "overlay",
  "control-center-exclusive-zone": false,
  "control-center-margin-top": 0,
  "control-center-margin-bottom": 0,
  "control-center-margin-right": 0,
  "control-center-margin-left": 0,
  "control-center-width": 410,
  "control-center-height": 600,
  "fit-to-screen": false,

  "notification-window-width": 360,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "image-visibility": "when-available",

  "timeout": 6,
  "timeout-low": 4,
  "timeout-critical": 0,
  "transition-time": 150,

  "relative-timestamps": true,
  "keyboard-shortcuts": true,
  "notification-grouping": true,
  "hide-on-clear": false,
  "hide-on-action": true,
  "text-empty": "no notifications",
  "script-fail-notify": true,

  "widgets": [
    "label#quick",
    "buttons-grid#quick",
    "dnd",
    "title",
    "notifications"
  ],
  "widget-config": {
    "label#quick": {
      "text": "quick access",
      "max-lines": 1
    },
    "buttons-grid#quick": {
      "buttons-per-row": 4,
      "actions": [
        {
          "label": "󰂯",
          "command": "sh -c 'swaync-client -cp; if command -v bluetui >/dev/null; then exec ghostty --class=quick.bluetui --title=bluetooth -e bluetui; else exec $HOME/.config/waybar/scripts/bt-module.sh --menu; fi'"
        },
        {
          "label": "󰄀",
          "command": "sh -c 'exec $HOME/.config/waybar/scripts/screenshot.sh'"
        },
        {
          "label": "󰑋",
          "type": "toggle",
          "command": "sh -c 'swaync-client -cp; exec $HOME/.config/waybar/scripts/obs-record.py toggle'",
          "update-command": "sh -c 'exec $HOME/.config/waybar/scripts/obs-record.py status'"
        },
        {
          "label": "󱎫",
          "type": "toggle",
          "command": "sh -c 'exec $HOME/.config/waybar/scripts/pomodoro.sh toggle'",
          "update-command": "sh -c 'exec $HOME/.config/waybar/scripts/pomodoro.sh status'"
        },
        {
          "label": "󰄜",
          "command": "sh -c 'swaync-client -cp; exec kdeconnect-app'"
        },
        {
          "label": "󰧭",
          "command": "sh -c 'exec $HOME/.config/waybar/scripts/notes.sh'"
        },
        {
          "label": "󰃬",
          "command": "sh -c 'swaync-client -cp; exec flatpak run io.github.Go08er.GlazeMyNumbersBaby'"
        }
      ]
    },
    "title": {
      "text": "notifications",
      "clear-all-button": true,
      "button-text": "clear"
    },
    "dnd": {
      "text": "do not disturb"
    },
    "notifications": {
      "vexpand": true
    }
  }
}
